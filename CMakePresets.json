{
  "version": 3,
  "configurePresets": [
    {
      "name": "msvc-ninja",
      "displayName": "MSVC x64 (Ninja, Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-ninja",
      "configurePreset": "msvc-ninja"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-ninja",
      "configurePreset": "msvc-ninja",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
